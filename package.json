{
  "name": "photo-2k",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 43180",
    "build": "tsc -b && vite build",
    "build:phone": "tsc -b && vite build --mode phone",
    "check": "node --experimental-strip-types src/lanczos.check.ts && node --experimental-strip-types src/realesrgan.check.ts",
